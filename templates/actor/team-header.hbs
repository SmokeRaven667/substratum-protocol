<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" alt="{{actor.name}}"
    {{#if isEditable}}data-action="editImage"{{/if}}>

  <div class="header-fields">
    <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'SUBSTRATUM.Name'}}"
      {{#unless isEditable}}disabled{{/unless}}>

    <div class="header-row stress-row">
      <label class="header-field stress-field">
        <span>{{localize "SUBSTRATUM.Stress"}}</span>
        <input type="number" name="system.stress.value" value="{{system.stress.value}}" min="0"
          {{#unless isEditable}}disabled{{/unless}}>
        <span class="stress-sep">/</span>
        <input type="number" name="system.stress.max" value="{{system.stress.max}}" min="1"
          {{#unless isEditable}}disabled{{/unless}}>
      </label>

      <div class="header-field stress-field">
        <span>{{localize "SUBSTRATUM.Deaths"}}</span>
        <span class="deaths-value">{{system.deaths}}</span>
        <span class="stress-sep">/ 3</span>
      </div>
    </div>

    <div class="header-row">
      <label class="header-field checkbox-field">
        <input type="checkbox" name="system.deepBreathUsed" {{#if system.deepBreathUsed}}checked{{/if}}
          {{#unless isEditable}}disabled{{/unless}}>
        <span>{{localize "SUBSTRATUM.DeepBreathUsed"}}</span>
      </label>
      {{#if isEditable}}
        <button type="button" data-action="deepBreath" {{#if system.deepBreathUsed}}disabled{{/if}}>
          <i class="fas fa-wind"></i> {{localize "SUBSTRATUM.DeepBreath"}}
        </button>
      {{/if}}
    </div>

    {{#if isEditable}}
      <div class="header-row substratum-death-controls">
        <label class="header-field">
          <span>{{localize "SUBSTRATUM.SkillToStepDown"}}</span>
          <select data-role="death-skill">
            {{#each skills}}<option value="{{this.key}}">{{localize this.label}}</option>{{/each}}
          </select>
        </label>
        <button type="button" data-action="recordDeath" {{#if teamWiped}}disabled{{/if}}>
          <i class="fas fa-skull"></i> {{localize "SUBSTRATUM.RecordDeath"}}
        </button>
      </div>
    {{/if}}

    {{#if teamWiped}}
      <div class="team-wiped-banner">{{localize "SUBSTRATUM.TeamWiped"}}</div>
    {{/if}}
  </div>
</header>

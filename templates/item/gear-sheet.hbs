<div class="gear-sheet-body">
  <header class="sheet-header">
    <img class="item-img" src="{{item.img}}" alt="{{item.name}}"
      {{#if isEditable}}data-action="editImage"{{/if}}>
    <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'SUBSTRATUM.Name'}}"
      {{#unless isEditable}}disabled{{/unless}}>
  </header>

  <div class="gear-fields">
    {{#unless system.narrativeOnly}}
      <label class="gear-field">
        <span>{{localize "SUBSTRATUM.MaxDieRating"}}</span>
        <select name="system.dieRating.max" {{#unless isEditable}}disabled{{/unless}}>
          {{selectOptions dieChainOptions selected=system.dieRating.max}}
        </select>
      </label>

      <label class="gear-field">
        <span>{{localize "SUBSTRATUM.DieRating"}}</span>
        <select name="system.dieRating.current" {{#unless isEditable}}disabled{{/unless}}>
          {{selectOptions dieChainOptions selected=system.dieRating.current}}
        </select>
      </label>
    {{/unless}}

    <label class="checkbox-field">
      <input type="checkbox" name="system.narrativeOnly" {{#if system.narrativeOnly}}checked{{/if}}
        {{#unless isEditable}}disabled{{/unless}}>
      <span>{{localize "SUBSTRATUM.NarrativeOnly"}}</span>
    </label>

    <label class="checkbox-field">
      <input type="checkbox" name="system.broken" {{#if system.broken}}checked{{/if}}
        {{#unless isEditable}}disabled{{/unless}}>
      <span>{{localize "SUBSTRATUM.Broken"}}</span>
    </label>
  </div>

  <div class="gear-description">
    <label>{{localize "SUBSTRATUM.Description"}}</label>
    {{#if isEditable}}
      <prose-mirror name="system.description" value="{{system.description}}" button="true" editable="true"
        toggled="false">{{{descriptionHTML}}}</prose-mirror>
    {{else}}
      <div class="substratum-richtext-readonly">{{{descriptionHTML}}}</div>
    {{/if}}
  </div>
</div>
